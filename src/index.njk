<section class="content-section news-section scroll-reveal" aria-labelledby="news-title">
  <h2 id="news-title" class="section-heading">news</h2>
  <ol class="news-list">
    {% for item in news %}
      {% if item.date_iso >= "2025-01" %}
      <li>
        <time datetime="{{ item.date_iso }}">{{ item.display_date }}</time>
        <p>{% for segment in item.segments %}{% if segment.url %}<a href="{{ segment.url }}">{{ segment.label }}</a>{% elif segment.italic %}<em>{{ segment.text }}</em>{% else %}{{ segment.text }}{% endif %}{% endfor %}</p>
      </li>
      {% endif %}
    {% endfor %}
  </ol>

  <details class="news-archive">
    <summary class="news-archive-toggle">
      <span class="news-toggle-more">Show earlier news (2020–2024)</span>
      <span class="news-toggle-less">Hide earlier news</span>
      <svg class="news-toggle-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </summary>
    <ol class="news-list news-list-archive">
      {% for item in news %}
        {% if item.date_iso < "2025-01" %}
        <li>
          <time datetime="{{ item.date_iso }}">{{ item.display_date }}</time>
          <p>{% for segment in item.segments %}{% if segment.url %}<a href="{{ segment.url }}">{{ segment.label }}</a>{% elif segment.italic %}<em>{{ segment.text }}</em>{% else %}{{ segment.text }}{% endif %}{% endfor %}</p>
        </li>
        {% endif %}
      {% endfor %}
    </ol>
  </details>
</section>

