<!doctype html>
<html lang="en" class="no-js" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <script>
    (function () {
      var root = document.documentElement;
      root.classList.remove('no-js');
      root.classList.add('js');
      var storedTheme = null;
      try { storedTheme = localStorage.getItem('theme'); } catch (error) { storedTheme = null; }
      var systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      var activeTheme = storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : systemTheme;
      root.setAttribute('data-theme', activeTheme);
      var schemeMeta = document.querySelector('meta[name="color-scheme"]');
      if (schemeMeta && (storedTheme === 'dark' || storedTheme === 'light')) {
        schemeMeta.setAttribute('content', storedTheme);
      }
    })();
  </script>

  <title>{{ title }}</title>
  <meta name="description" content="{{ description or site.defaultDescription }}">
  <meta name="robots" content="{{ robots or 'index,follow' }}">
  <meta name="author" content="{{ site.name }}">
  <link rel="canonical" href="{{ site.url }}{{ canonicalPath }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or site.defaultDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ canonicalPath }}">
  <meta property="og:image" content="{{ site.url }}{{ socialImage or '/assets/images/me.jpg' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description or site.defaultDescription }}">
  <meta name="twitter:image" content="{{ site.url }}{{ socialImage or '/assets/images/me.jpg' }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/site.css">

  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analyticsId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.analyticsId }}');
  </script>
  <script src="/assets/js/site.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header">
    <nav class="site-nav site-shell" aria-label="Primary navigation">
      <a class="site-brand" href="/index.html" aria-label="{{ site.name }} homepage">
        <img class="brand-logo brand-logo-hku" src="/assets/images/hku_crest.svg" width="32" height="36" alt="The University of Hong Kong">
        <span class="brand-divider" aria-hidden="true"></span>
        <img class="brand-logo brand-logo-ece brand-logo-light" src="/assets/images/hku_ece_logo.svg" width="164" height="33" alt="Department of Electrical and Computer Engineering, HKU">
        <img class="brand-logo brand-logo-ece brand-logo-dark" src="/assets/images/hku_ece_logo_dark.svg" width="164" height="33" alt="">
      </a>
      <div class="nav-right">
        <div class="nav-links">
          {% for item in site.navigation %}
            <a href="{{ item.url }}"
               {% if currentNav == item.label %}aria-current="page"{% endif %}
               {% if item.external %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.label }}{% if item.external %}<span class="visually-hidden"> (opens in a new tab)</span>{% endif %}</a>
          {% endfor %}
        </div>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
          <svg class="theme-icon sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4.5"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="theme-icon moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </nav>
  </header>

  <main id="main-content" class="site-main site-shell">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="site-shell footer-inner">
      <p>&copy; {{ currentYear }} {{ site.name }}. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
