---
layout: layouts/base.njk
permalink: software.html
title: Software — Zhaolin Wang
description: Open-source research software developed by Zhaolin Wang for wireless communications, digital twins, and reproducible wireless studies.
canonicalPath: /software.html
currentNav: Software
socialImage: /assets/images/software/openairtwin-showcase.png
---
<header class="page-header scroll-reveal">
  <h1 class="page-title">software</h1>
</header>

{% for project in software.projects %}
<article class="content-section software-project scroll-reveal" aria-labelledby="{{ project.id }}-title">
  <div class="software-heading">
    <div class="software-title-group">
      <h2 class="software-logo-title" id="{{ project.id }}-title">
        <span class="visually-hidden">{{ project.name }}</span>
        <img class="software-logo software-logo-light"
             src="{{ project.logo_light }}"
             width="{{ project.logo_width }}"
             height="{{ project.logo_height }}"
             alt=""
             aria-hidden="true">
        <img class="software-logo software-logo-dark"
             src="{{ project.logo_dark }}"
             width="{{ project.logo_width }}"
             height="{{ project.logo_height }}"
             alt=""
             aria-hidden="true">
      </h2>
      <p class="software-tagline">{{ project.tagline }}</p>
    </div>
  </div>

  <nav class="software-actions" aria-label="{{ project.name }} resources">
    <ul>
      <li><a class="button-link" href="{{ project.repository }}">GitHub Repository</a></li>
      {% for link in project.links %}
      <li><a class="software-action-link" href="{{ link.url }}">{{ link.label }}</a></li>
      {% endfor %}
    </ul>
  </nav>

  <figure class="software-hero">
    {% if project.image_viewbox %}
    {# Fit the screenshot window to the content width, excluding transparent padding. #}
    <svg viewBox="{{ project.image_viewbox }}" role="img" aria-label="{{ project.image_alt }}">
      <image href="{{ project.image }}"
             width="{{ project.image_width }}"
             height="{{ project.image_height }}" />
    </svg>
    {% else %}
    <img src="{{ project.image }}"
         width="{{ project.image_width }}"
         height="{{ project.image_height }}"
         alt="{{ project.image_alt }}"
         loading="lazy">
    {% endif %}
  </figure>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "name": "{{ project.name }}",
  "description": "{{ project.description }}",
  "codeRepository": "{{ project.repository }}",
  "url": "{{ project.website or project.repository }}",
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "version": "{{ project.version | replace('v', '') }}",
  "programmingLanguage": {{ project.programming_languages | dump | safe }}
}
</script>
{% endfor %}
